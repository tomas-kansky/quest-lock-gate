<Window x:Class="QuestLock.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuestLock Gate" 
        WindowStyle="None" 
        ResizeMode="NoResize" 
        Topmost="True" 
        ShowInTaskbar="False"
        Background="#0f172a"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2563eb"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionPadButtonStyle" TargetType="Button" BasedOn="{StaticResource PadButtonStyle}">
            <Setter Property="Background" Value="#1e40af"/>
            <Setter Property="FontSize" Value="22"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563eb"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1d4ed8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClearPadButtonStyle" TargetType="Button" BasedOn="{StaticResource PadButtonStyle}">
            <Setter Property="Background" Value="#7f1d1d"/>
            <Setter Property="Foreground" Value="#fecaca"/>
            <Setter Property="FontSize" Value="22"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#991b1b"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#b91c1c"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Aktivní karta úloh -->
        <Border x:Name="QuestCard" 
                Background="#1e293b" 
                CornerRadius="28" 
                Width="520" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Padding="36,32" 
                BorderBrush="#334155" 
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <!-- Hlavička -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="🔒 QUESTLOCK GATE" FontSize="14" FontWeight="Bold" Foreground="#38bdf8" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Denní matematická výzva" FontSize="26" FontWeight="ExtraBold" Foreground="#ffffff" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ProgressText" Text="Úkol 1 z 5" FontSize="16" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Zadání příkladu -->
                <Border Background="#0f172a" CornerRadius="20" Padding="20" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ExpressionText" Text="81 : 9 =" FontSize="48" FontWeight="Bold" Foreground="#f8fafc" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Border Background="#1e293b" CornerRadius="12" MinWidth="110" Height="68" Padding="12,0" VerticalAlignment="Center" BorderBrush="#3b82f6" BorderThickness="2">
                            <TextBlock x:Name="AnswerText" Text="" FontSize="44" FontWeight="Bold" Foreground="#60a5fa" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Chybová / stavová zpráva -->
                <TextBlock x:Name="FeedbackText" Text="" FontSize="15" FontWeight="SemiBold" Foreground="#ef4444" HorizontalAlignment="Center" TextAlignment="Center" MinHeight="22" Margin="0,0,0,16"/>

                <!-- Dotykový / klikatelný NumPad -->
                <Grid Width="380" Height="320" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource PadButtonStyle}" Click="PadButton_Click"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource PadButtonStyle}" Click="PadButton_Click"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource PadButtonStyle}" Click="PadButton_Click"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource PadButtonStyle}" Click="PadButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource PadButtonStyle}" Click="PadButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource PadButtonStyle}" Click="PadButton_Click"/>

                    <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource PadButtonStyle}" Click="PadButton_Click"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource PadButtonStyle}" Click="PadButton_Click"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource PadButtonStyle}" Click="PadButton_Click"/>

                    <Button Grid.Row="3" Grid.Column="0" Content="C" Style="{StaticResource ClearPadButtonStyle}" Click="ClearButton_Click"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource PadButtonStyle}" Click="PadButton_Click"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="⏎" Style="{StaticResource ActionPadButtonStyle}" Click="SubmitButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Karta úspěšného dokončení -->
        <Border x:Name="SuccessCard" 
                Background="#1e293b" 
                CornerRadius="28" 
                Width="500" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Padding="40,48" 
                BorderBrush="#16a34a" 
                BorderThickness="2"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#16a34a" BlurRadius="50" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🎉" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Skvělá práce!" FontSize="32" FontWeight="Bold" Foreground="#ffffff" HorizontalAlignment="Center"/>
                <TextBlock Text="Dnešní výzva je splněna." FontSize="18" Foreground="#86efac" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="Počítač je odemčen. Užij si hraní!" FontSize="15" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,16,0,32" TextAlignment="Center"/>

                <Button Content="Vstoupit do Windows" Width="260" Height="56" FontSize="18" FontWeight="Bold" 
                        Background="#22c55e" Foreground="#ffffff" Cursor="Hand" Click="DismissSuccess_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
